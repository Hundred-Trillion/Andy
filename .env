# ANDY v1 - Environment Configuration

# ==========================================
# ONLINE MODE (OpenRouter / Nvidia Nemotron)
# ==========================================
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# ==========================================
# OFFLINE MODE (Local vLLM / Qwen)
# ==========================================
# Make sure your start_vllm.sh script is running before starting the backend!
OPENROUTER_API_KEY=empty
OPENROUTER_BASE_URL=http://localhost:8080/v1
LLM_MODEL_NAME=qwen72b

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
